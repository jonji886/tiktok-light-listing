# 环境变量示例：复制为 .env 并填入真实值（.env 已被 .gitignore 排除）
# 用法：set -a; source .env; set +a

# 目标 ERP 站点地址（必填）
ERP_BASE_URL=https://your-erp-host.example.com
# 同一后端的备用域名（可选，kdzs_fastmoss.py 用；留空则只用 ERP_BASE_URL）
ERP_ALT_BASE_URL=

# 登录态 JWT（也可写入 scripts/erp_token.txt，二选一）
ERP_TOKEN=

# 泰国站店铺
TH_SELLER_ID=
TH_SHOP_NICK=

# 越南站店铺
VN_SELLER_ID=
VN_SHOP_NICK=

# 发布接口必填的来源 sellerId（从自己浏览器的发布请求里取值）
ERP_SOURCE_SELLER_ID=
