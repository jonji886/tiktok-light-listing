# 环境变量示例：复制为 .env 并填入真实值（.env 已被 .gitignore 排除）
# 用法：set -a; source .env; set +a

# 目标 ERP 站点地址（必填）
ERP_BASE_URL=https://your-erp-host.example.com
# 同一后端的备用域名（可选，kdzs_fastmoss.py 用；留空则只用 ERP_BASE_URL）
ERP_ALT_BASE_URL=

# 登录态 JWT（也可写入 scripts/erp_token.txt，二选一）
ERP_TOKEN=

# 马来西亚站店铺（2026-11-19 起主攻）
MY_SELLER_ID=
MY_SHOP_NICK=

# 泰国站 / 越南站店铺（存量维护，不投新品）
TH_SELLER_ID=
TH_SHOP_NICK=
VN_SELLER_ID=
VN_SHOP_NICK=

# 发布接口必填的来源 sellerId（从自己浏览器的发布请求里取值；`erp_client.py shops` 可查）
# 2026-11-27 起代码不再内置真实值：未配置时 ttl-publish 直接 fail-fast
ERP_SOURCE_SELLER_ID=

# HTTP 超时集中配置（秒；不填用默认值）
ERP_HTTP_TIMEOUT=30
ERP_SITE_HTTP_TIMEOUT=180

# 阿里云 Aidge（图片修复管道：消除/图翻/抠图）——RAM 用户 AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
